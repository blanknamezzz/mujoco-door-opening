        <body name="upper">
          <joint name="shoulder" axis="0 0 1" range="-2.879793 2.879793"/>
          <geom name="upper_link" class="arm" fromto="0 0 0 0.6 0 0" mass="1"/>
          <body name="forearm" pos="0.6 0 0">
            <joint name="elbow" axis="0 0 1" range="-2.879793 2.879793"/>
            <geom name="forearm_link" class="arm" fromto="0 0 0 0.55 0 0" mass="0.8"/>
            <body name="hand" pos="0.55 0 0">
              <joint name="wrist_yaw" axis="0 0 1" range="-2.96706 2.96706"/>
              <geom name="wrist_link" class="arm" fromto="0 0 0 0.065 0 0" mass="0.15"/>
              <geom name="palm" type="box" pos="0.085 0 0" size="0.025 0.068 0.032" mass="0.25" rgba="0.25 0.65 0.75 1"/>
              <site name="grasp_center" pos="0.18 0 0" size="0.004" rgba="0.1 1 0.2 1"/>
              <body name="left_finger" pos="0 0.012 0">
                <joint name="left_slide" type="slide" axis="0 1 0" range="0 0.045" damping="2" armature="0.001"/>
                <geom name="left_finger_link" type="box" pos="0.13 0 0" size="0.022 0.008 0.02" mass="0.04" rgba="0.5 0.6 0.65 1"/>
                <geom name="left_pad" class="pad" pos="0.18 0 0"/>
              </body>
              <body name="right_finger" pos="0 -0.012 0">
                <joint name="right_slide" type="slide" axis="0 -1 0" range="0 0.045" damping="2" armature="0.001"/>
                <geom name="right_finger_link" type="box" pos="0.13 0 0" size="0.022 0.008 0.02" mass="0.04" rgba="0.5 0.6 0.65 1"/>
                <geom name="right_pad" class="pad" pos="0.18 0 0"/>
