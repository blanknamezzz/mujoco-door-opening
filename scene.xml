    <position name="lift_servo" joint="lift_z" kp="3000" kv="100" forcerange="-200 200"/>
    <position name="shoulder_servo" joint="shoulder" kp="600" kv="45" forcerange="-120 120"/>
    <position name="elbow_servo" joint="elbow" kp="600" kv="40" forcerange="-100 100"/>
    <position name="wrist_servo" joint="wrist_yaw" kp="300" kv="20" forcerange="-45 45"/>
    <position name="left_grip" joint="left_slide" kp="1800" kv="8" forcerange="-35 35"/>
    <position name="right_grip" joint="right_slide" kp="1800" kv="8" forcerange="-35 35"/>
  </actuator>
</mujoco>
